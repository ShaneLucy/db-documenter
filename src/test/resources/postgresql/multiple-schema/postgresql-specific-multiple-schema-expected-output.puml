@startuml
hide methods
hide stereotypes

package "auth" {
	entity "account_status" <<enum>> {
		pending_verification
		active
		suspended
		deactivated
		locked
	}

	entity "mfa_method" <<enum>> {
		totp
		sms
		email
		hardware_key
		backup_codes
	}

	entity "users" {
		**id: uuid**
		--
		email: character varying(255) <<UNIQUE>>
		email_verified: boolean
		email_verified_at: timestamp with time zone
		username: character varying(50) <<UNIQUE>>
		password_hash: character varying(255)
		password_changed_at: timestamp with time zone
		profile: jsonb
		preferred_languages: text[]
		status: account_status
		search_vector: tsvector
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
		last_login_at: timestamp with time zone
		login_count: integer
		failed_login_count: integer
		locked_until: timestamp with time zone
	}

	entity "user_mfa" {
		**id: uuid**
		--
		user_id: uuid <<FK,UNIQUE>>
		method: mfa_method
		secret_encrypted: bytea
		backup_codes: text[]
		is_primary: boolean <<UNIQUE>>
		is_verified: boolean
		verified_at: timestamp with time zone
		metadata: jsonb
		created_at: timestamp with time zone
		last_used_at: timestamp with time zone
	}

	entity "roles" {
		**id: integer**
		--
		code: character varying(50) <<UNIQUE>>
		name: character varying(100)
		description: text
		parent_role_id: integer <<FK>>
		is_system_role: boolean
		settings: jsonb
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
	}

	entity "permissions" {
		**id: integer**
		--
		code: character varying(100) <<UNIQUE>>
		name: character varying(200)
		description: text
		categories: text[]
		resource: character varying(50) <<UNIQUE>>
		action: character varying(50) <<UNIQUE>>
		created_at: timestamp with time zone
	}

	entity "role_permissions" {
		**role_id: integer** <<FK>>
		**permission_id: integer** <<FK>>
		--
		conditions: jsonb
		granted_at: timestamp with time zone
		granted_by: uuid <<FK>>
	}

	entity "user_roles" {
		**user_id: uuid** <<FK>>
		**role_id: integer** <<FK>>
		**organization_id_key: uuid**
		--
		organization_id: uuid <<FK>>
		valid_from: timestamp with time zone
		valid_until: timestamp with time zone
		assigned_at: timestamp with time zone
		assigned_by: uuid <<FK>>
	}

	entity "sessions" {
		**id: uuid**
		--
		user_id: uuid <<FK>>
		token_hash: character varying(64) <<UNIQUE>>
		metadata: jsonb
		created_at: timestamp with time zone
		expires_at: timestamp with time zone
		last_activity: timestamp with time zone
		revoked_at: timestamp with time zone
		revoked_reason: character varying(100)
	}

}

package "core" {
	entity "priority_level" <<enum>> {
		critical
		high
		medium
		low
		none
	}

	entity "project_status" <<enum>> {
		planning
		active
		on_hold
		completed
		archived
		cancelled
	}

	entity "subscription_tier" <<enum>> {
		free
		starter
		professional
		enterprise
		custom
	}

	entity "task_status" <<enum>> {
		backlog
		todo
		in_progress
		in_review
		blocked
		done
		cancelled
	}

	entity "organizations" {
		**id: uuid**
		--
		name: character varying(200)
		slug: character varying(100) <<UNIQUE>>
		billing_address: core.address_type
		subscription_tier: subscription_tier
		subscription_data: jsonb
		settings: jsonb
		allowed_domains: text[]
		search_vector: tsvector
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
		created_by: uuid <<FK>>
		deleted_at: timestamp with time zone
	}

	entity "organization_members" {
		**organization_id: uuid** <<FK>>
		**user_id: uuid** <<FK>>
		--
		display_name: character varying(100)
		role: character varying(50)
		permissions_override: jsonb
		invited_at: timestamp with time zone
		invited_by: uuid <<FK>>
		accepted_at: timestamp with time zone
		is_active: boolean
	}

	entity "projects" {
		**id: uuid**
		--
		organization_id: uuid <<FK,UNIQUE>>
		key: character varying(10) <<UNIQUE>>
		name: character varying(200)
		description: text
		status: project_status
		lead_id: uuid <<FK>>
		start_date: date
		target_end_date: date
		actual_end_date: date
		tags: text[]
		color: character(7)
		custom_fields: jsonb
		settings: jsonb
		search_vector: tsvector
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
		created_by: uuid <<FK>>
		archived_at: timestamp with time zone
	}

	entity "tasks" {
		**id: uuid**
		--
		project_id: uuid <<FK,UNIQUE>>
		task_number: integer <<UNIQUE>>
		title: character varying(500)
		description: text
		status: task_status
		priority: priority_level
		assignee_ids: uuid[]
		reporter_id: uuid <<FK>>
		parent_task_id: uuid <<FK>>
		path: uuid[]
		depth: integer
		due_date: timestamp with time zone
		started_at: timestamp with time zone
		completed_at: timestamp with time zone
		estimated_minutes: integer
		logged_minutes: integer
		remaining_minutes: integer
		story_points: smallint
		labels: text[]
		custom_fields: jsonb
		search_vector: tsvector
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
		created_by: uuid <<FK>>
	}

	entity "task_dependencies" {
		**predecessor_id: uuid** <<FK>>
		**successor_id: uuid** <<FK>>
		--
		dependency_type: character varying(20)
		lag_days: integer
		created_at: timestamp with time zone
		created_by: uuid <<FK>>
	}

	entity "time_entries" {
		**id: uuid**
		--
		task_id: uuid <<FK>>
		user_id: uuid <<FK>>
		started_at: timestamp with time zone
		ended_at: timestamp with time zone
		duration_minutes: integer
		description: text
		is_billable: boolean
		billing_rate: core.money_amount
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
	}

	entity "resource_bookings" {
		**id: uuid**
		--
		resource_type: character varying(50)
		resource_id: uuid
		booked_by: uuid <<FK>>
		organization_id: uuid <<FK>>
		booking_start: timestamp with time zone
		booking_end: timestamp with time zone
		booking_range: tstzrange
		title: character varying(200)
		description: text
		recurrence: jsonb
		created_at: timestamp with time zone
	}

	entity "comments" {
		**id: uuid**
		--
		entity_type: character varying(50)
		entity_id: uuid
		content: text
		content_html: text
		search_vector: tsvector
		parent_id: uuid <<FK>>
		mentioned_user_ids: uuid[]
		reactions: jsonb
		author_id: uuid <<FK>>
		is_edited: boolean
		edited_at: timestamp with time zone
		created_at: timestamp with time zone
		updated_at: timestamp with time zone
		deleted_at: timestamp with time zone
	}

}

package "analytics" {
	entity "daily_project_stats" {
		**stat_date: date**
		**project_id: uuid**
		--
		id: bigint
		organization_id: uuid
		tasks_backlog: integer
		tasks_todo: integer
		tasks_in_progress: integer
		tasks_in_review: integer
		tasks_blocked: integer
		tasks_done: integer
		tasks_cancelled: integer
		tasks_total: integer
		tasks_completed_pct: numeric(5,2)
		story_points_total: integer
		story_points_completed: integer
		estimated_minutes: bigint
		logged_minutes: bigint
		active_member_count: integer
		active_member_ids: uuid[]
		computed_at: timestamp with time zone
	}

	entity "user_activity_summary" {
		**user_id: uuid** <<FK>>
		**period_start: date**
		**period_type: character varying(10)**
		--
		tasks_created: integer
		tasks_completed: integer
		comments_posted: integer
		time_entries_count: integer
		minutes_logged: integer
		active_project_ids: uuid[]
		activity_breakdown: jsonb
		computed_at: timestamp with time zone
	}

}

package "audit" {
	entity "action_type" <<enum>> {
		create
		read
		update
		delete
		login
		logout
		permission_change
		export
		bulk_operation
	}

	entity "audit_log" {
		**id: bigint**
		**event_time: timestamp with time zone**
		--
		user_id: uuid
		session_id: uuid
		ip_address: inet
		user_agent: text
		organization_id: uuid
		action: action_type
		entity_type: character varying(100)
		entity_id: text
		old_values: jsonb
		new_values: jsonb
		changed_fields: text[]
		context: jsonb
		request_id: uuid
		correlation_id: uuid
	}

	entity "entity_changes" {
		**id: bigint**
		--
		entity_type: character varying(100)
		entity_id: uuid
		version: integer
		changed_at: timestamp with time zone
		changed_by: uuid <<FK>>
		change_type: character varying(20)
		data_snapshot: jsonb
	}

	entity "task_changes" {
		id: bigint
		entity_type: character varying(100)
		entity_id: uuid
		version: integer
		changed_at: timestamp with time zone
		changed_by: uuid
		change_type: character varying(20)
		data_snapshot: jsonb
		project_id: uuid
		task_number: integer
		status_before: core.task_status
		status_after: core.task_status
	}

	entity "project_changes" {
		id: bigint
		entity_type: character varying(100)
		entity_id: uuid
		version: integer
		changed_at: timestamp with time zone
		changed_by: uuid
		change_type: character varying(20)
		data_snapshot: jsonb
		organization_id: uuid
		status_before: core.project_status
		status_after: core.project_status
	}

	entity "access_log" {
		**id: bigint**
		--
		event_time: timestamp with time zone
		user_id: uuid <<FK>>
		session_id: uuid
		client_ip: inet
		client_ip_network: cidr
		request_method: character varying(10)
		request_path: text
		request_query: jsonb
		response_status: smallint
		response_time_ms: integer
		geo_country: character(2)
		geo_region: character varying(100)
		geo_city: character varying(100)
		geo_coordinates: point
		risk_score: smallint
		risk_factors: text[]
		metadata: jsonb
	}

}

core.organizations ||--o{ auth.user_roles

permissions ||--|{ role_permissions

roles ||--o{ roles
roles ||--|{ role_permissions
roles ||--|{ user_roles

users ||--|{ user_mfa
users ||--o{ role_permissions
users ||--|{ user_roles
users ||--o{ user_roles
users ||--|{ sessions

comments ||--o{ comments

organizations ||--|{ organization_members
organizations ||--|{ projects
organizations ||--|{ resource_bookings

projects ||--|{ tasks

tasks ||--o{ tasks
tasks ||--|{ task_dependencies
tasks ||--|{ task_dependencies
tasks ||--|{ time_entries

auth.users ||--o{ core.organizations
auth.users ||--|{ core.organization_members
auth.users ||--o{ core.organization_members
auth.users ||--o{ core.projects
auth.users ||--o{ core.projects
auth.users ||--o{ core.tasks
auth.users ||--o{ core.tasks
auth.users ||--o{ core.task_dependencies
auth.users ||--|{ core.time_entries
auth.users ||--|{ core.resource_bookings
auth.users ||--|{ core.comments

auth.users ||--|{ analytics.user_activity_summary

auth.users ||--o{ audit.entity_changes
auth.users ||--o{ audit.access_log

@enduml
