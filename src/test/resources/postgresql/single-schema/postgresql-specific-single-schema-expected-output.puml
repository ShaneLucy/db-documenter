@startuml
hide methods
hide stereotypes

package "public" {
	entity "app_user" {
		**id: uuid**
		--
		username: character varying(50) <<UNIQUE>>
		email: character varying(255) <<UNIQUE>>
		display_name: character varying(100)
		birth_date: date
		created_at: timestamp with time zone
		profile: jsonb
		is_active: boolean
	}

	entity "role" {
		**id: smallint**
		--
		code: character varying(50) <<UNIQUE>>
		description: character varying(255)
	}

	entity "user_role" {
		**user_id: uuid** <<FK>>
		**role_id: smallint** <<FK>>
		--
		assigned_at: timestamp with time zone
		assigned_by: uuid <<FK>>
	}

	entity "address" {
		**id: bigint**
		--
		user_id: uuid <<FK>>
		line1: character varying(200)
		line2: character varying(200)
		city: character varying(100)
		state: character varying(100)
		postal_code: character varying(20)
		country: character(2)
		created_at: timestamp with time zone
	}

	entity "product" {
		**id: bigint**
		--
		sku: character varying(30) <<UNIQUE>>
		name: character varying(200)
		description: text
		price: numeric(19,2)
		attributes: jsonb
		created_at: timestamp without time zone
		stock: integer
	}

	entity "category" {
		**id: smallint**
		--
		slug: character varying(80) <<UNIQUE>>
		title: character varying(120)
		metadata: jsonb
	}

	entity "product_category" {
		**product_id: bigint** <<FK>>
		**category_id: smallint** <<FK>>
		--
		assigned_at: timestamp with time zone
	}

	entity "customer_order" {
		**id: bigint**
		--
		user_id: uuid <<FK>>
		order_number: character varying(30) <<UNIQUE>>
		order_date: timestamp with time zone
		ship_date: timestamp without time zone
		shipping_address_id: bigint <<FK>>
		status: order_status
		total: numeric(19,2)
		metadata: jsonb
	}

	entity "order_item" {
		**id: bigint**
		--
		order_id: bigint <<FK,UNIQUE>>
		product_id: bigint <<FK,UNIQUE>>
		product_snapshot: jsonb
		unit_price: numeric(19,2)
		quantity: integer
		line_total: numeric(19,2)
	}

	entity "payment" {
		**id: uuid**
		--
		order_id: bigint <<FK>>
		paid_at: timestamp with time zone
		amount: numeric(19,2)
		method: character varying(50)
		provider_transaction_id: character varying(255)
		raw_response: jsonb
	}

	entity "audit_log" {
		**id: bigint**
		--
		entity_type: character varying(100)
		entity_id: text
		action: character varying(50)
		performed_by: uuid <<FK>>
		performed_at: timestamp with time zone
		details: jsonb
	}

	entity "tag_log" {
		tag_id: character varying(50)
		logged_at: timestamp with time zone
	}

	entity "product_status" {
		**id: smallint**
		--
		code: character varying(50) <<UNIQUE>>
	}

	entity "product_listing" {
		**id: bigint**
		--
		listed_by: uuid <<FK>>
		product_id: bigint <<FK>>
		status_id: smallint <<FK>>
		title: character varying(200)
		listed_at: timestamp with time zone
	}

}

address ||--o{ customer_order

app_user ||--|{ user_role
app_user ||--o{ user_role
app_user ||--|{ address
app_user ||--o{ customer_order
app_user ||--o{ audit_log
app_user ||--o{ product_listing

category ||--|{ product_category

customer_order ||--|{ order_item
customer_order ||--|{ payment

product ||--|{ product_category
product ||--|{ order_item
product ||--o{ product_listing

product_status ||--|{ product_listing

role ||--|{ user_role

@enduml
